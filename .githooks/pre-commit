#!/usr/bin/env bash
# .githooks/pre-commit
# Enforces:
#   1. Go formatting (gofmt)
#   2. Go vet
#   3. Go tests with race detector
#   4. TypeScript type-checking (tsc)
#   5. ESLint
#   6. Frontend unit tests (Vitest + node:test)
#
# Enable in repository: git config core.hooksPath .githooks

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
RESET='\033[0m'

pass() { echo -e "${GREEN}✔${RESET} $1"; }
fail() { echo -e "${RED}✗${RESET} $1"; }
section() { echo -e "\n${BOLD}── $1 ──${RESET}"; }

ERRORS=0

# ── 1. gofmt ──────────────────────────────────────────────────────────────────
section "Go format (gofmt)"
STAGED_GO=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$' || true)

if [[ -n "$STAGED_GO" ]]; then
  UNFORMATTED=$(echo "$STAGED_GO" | xargs gofmt -l 2>/dev/null || true)
  if [[ -n "$UNFORMATTED" ]]; then
    fail "Unformatted Go files detected (run: gofmt -w <file>):"
    echo "$UNFORMATTED" | sed 's/^/    /'
    ERRORS=$((ERRORS + 1))
  else
    pass "All staged Go files are formatted"
  fi
else
  pass "No staged Go files"
fi

# ── 2. go vet ─────────────────────────────────────────────────────────────────
section "Go vet"
mkdir -p web/dist && touch web/dist/.gitkeep
if go vet ./... 2>&1; then
  pass "go vet passed"
else
  fail "go vet failed"
  ERRORS=$((ERRORS + 1))
fi

# ── 3. Go tests (race detector) ───────────────────────────────────────────────
section "Go tests (race detector)"
if go test -race -count=1 ./... 2>&1; then
  pass "All Go tests passed"
else
  fail "Go tests failed"
  ERRORS=$((ERRORS + 1))
fi

# ── 4. TypeScript type-check ──────────────────────────────────────────────────
section "TypeScript type-check (tsc)"
if [[ -d web/node_modules ]]; then
  if (cd web && npm run tsc --silent) 2>&1; then
    pass "TypeScript type-check passed"
  else
    fail "TypeScript type-check failed"
    ERRORS=$((ERRORS + 1))
  fi
else
  echo -e "${YELLOW}⚠${RESET}  web/node_modules not found — skipping tsc (run: cd web && npm ci)"
fi

# ── 5. ESLint ─────────────────────────────────────────────────────────────────
section "ESLint"
if [[ -d web/node_modules ]]; then
  if (cd web && npm run lint --silent) 2>&1; then
    pass "ESLint passed"
  else
    fail "ESLint failed"
    ERRORS=$((ERRORS + 1))
  fi
else
  echo -e "${YELLOW}⚠${RESET}  web/node_modules not found — skipping ESLint"
fi

# ── 6. Frontend tests ─────────────────────────────────────────────────────────
section "Frontend tests"
if [[ -d web/node_modules ]]; then
  if (cd web && npm run test:run --silent && npm test --silent) 2>&1; then
    pass "Frontend unit tests passed (Vitest + tabStore)"
  else
    fail "Frontend tests failed"
    ERRORS=$((ERRORS + 1))
  fi
else
  echo -e "${YELLOW}⚠${RESET}  web/node_modules not found — skipping frontend tests"
fi

# ── Result ────────────────────────────────────────────────────────────────────
echo ""
if [[ $ERRORS -gt 0 ]]; then
  echo -e "${RED}${BOLD}Commit blocked: $ERRORS check(s) failed.${RESET}"
  echo -e "Fix the issues above, then stage your changes and commit again."
  echo -e "${YELLOW}Tip:${RESET} In an emergency, bypass with: git commit --no-verify"
  exit 1
fi

echo -e "${GREEN}${BOLD}All checks passed — proceeding with commit.${RESET}"
exit 0
