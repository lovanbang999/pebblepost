# Maintainer: PebblePost Team <lovanbangbox9@gmail.com>
pkgname=pebblepost-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Lightweight, Git-friendly API client and runner for modern developers"
arch=('x86_64' 'aarch64')
url="https://github.com/lovanbang999/pebblepost"
license=('MIT')
provides=('pebblepost')
conflicts=('pebblepost')

source_x86_64=("https://github.com/lovanbang999/pebblepost/releases/download/v${pkgver}/pebblepost_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/lovanbang999/pebblepost/releases/download/v${pkgver}/pebblepost_${pkgver}_linux_arm64.tar.gz")

sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    cd "${srcdir}"
    install -Dm755 pebblepost "${pkgdir}/usr/bin/pebblepost"
    if [ -f pebblepost-server ]; then
        install -Dm755 pebblepost-server "${pkgdir}/usr/bin/pebblepost-server"
    fi
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
