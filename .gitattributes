# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Force LF on text, documentation, and test fixtures
*.go text eol=lf
*.md text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.sh text eol=lf
