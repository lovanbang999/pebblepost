meta {
  name: Login
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "{{secretPassword}}"
  }
}

tests {
  pb.test("Token received", () => {
    const data = pb.response.json();
    pb.environment.set("jwtToken", data.token);
  });
}
